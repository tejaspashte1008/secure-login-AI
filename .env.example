# ============================================================
# SecureLogin AI - Environment Configuration (.env)
# ============================================================

# Flask Secret Key (use a strong random string in production)
SECRET_KEY=change-this-to-a-very-secret-random-key

# Database URL (Default is local SQLite)
DATABASE_URL=sqlite:///secure_login.db

# ------------------------------------------------------------
# 1. SMTP EMAIL ALERT CONFIGURATION
# ------------------------------------------------------------
# For Gmail:
# - Go to your Google Account -> Security -> 2-Step Verification
# - Create an "App Password" (name it SecureLogin AI)
# - Paste that 16-character app password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_USE_TLS=True
ALERT_SENDER_EMAIL=your_email@gmail.com

# ------------------------------------------------------------
# 2. WHATSAPP ALERT CONFIGURATION
# ------------------------------------------------------------
# Option A: Twilio WhatsApp (Default & Recommended for college projects)
# - Sign up at twilio.com (free trial available)
# - Enable Twilio WhatsApp Sandbox
# - Copy Account SID & Auth Token from dashboard
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Generic REST WhatsApp Gateway (e.g., UltraMsg, Whapi)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
